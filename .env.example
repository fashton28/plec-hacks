# Port your agent listens on. The chat page and the test runner both default to it.
AGENT_PORT=8787

# The hosted sandbox. Leave the URL alone.
PLEC_SANDBOX_URL=https://api.plec.ai/hackathon/sandbox

# Your team's key. Copy it from https://plec.ai/hack/dashboard (it starts with hk_).
PLEC_SANDBOX_KEY=

# Your model access. Option 1 is the recommended one, and it is what the three
# lines below are already set up for.
#
# 1) PLEC's shared model proxy. PLEC lends its own Moonshot (Kimi) quota, so
#    you do not have to buy a key at the door. Mint your team's model key on
#    https://plec.ai/hack/dashboard (it starts with plk_) and paste it into
#    LLM_API_KEY. It is shown exactly once, so copy it then. The proxy is
#    shared across every team and capped per 5 minute window, and it stops
#    working when submissions close. Details: docs/model-proxy.md.
LLM_BASE_URL=https://api.plec.ai/hackathon/llm/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2.6

# 2) Bring your own key, if you would rather not share the cap. Any
#    OpenAI-compatible chat completions endpoint works with agent/llm.js.
#    Replace the three lines above with the provider's base URL, your own key
#    and a model that provider serves.
#    OpenAI:     https://api.openai.com/v1
#    Anthropic:  https://api.anthropic.com/v1
#    Groq:       https://api.groq.com/openai/v1
#    DeepSeek:   https://api.deepseek.com/v1
#    Moonshot:   https://api.moonshot.ai/v1
#    Ollama:     http://localhost:11434/v1   (any key works)

# Where the test runner sends turns. Change only if your agent is not on AGENT_PORT.
AGENT_URL=http://localhost:8787
