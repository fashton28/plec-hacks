# Model access. Any OpenAI-compatible chat completions endpoint.
# Default: PLEC's shared Kimi proxy (key starts with plk_, capped per 5 min window, shared with your teammate).
LLM_BASE_URL=https://api.plec.ai/hackathon/llm/v1
LLM_API_KEY=
MODEL_SMART=kimi-k2.7-code-highspeed
MODEL_FAST=kimi-k2.7-code-highspeed
# Seconds we are willing to wait out a 429 before giving up (replay-demo raises this).
LLM_MAX_WAIT_S=20

PORT=8788
AGENT_NAME=PLEC
AGENT_PHONE=
DEFAULT_CITY=Philadelphia
DEMO_ORGANIZER_PHONE=
# Email used for sandbox bookings when the organizer has not given one in chat.
ORGANIZER_EMAIL=
DEBOUNCE_MS=6000
DEBOUNCE_MENTION_MS=2000
# Pin "today" for a reproducible demo (YYYY-MM-DD). Empty = real date.
DEMO_TODAY=

# Venue data: mock (data/venues.json, deterministic demo) or sandbox (PLEC's hosted catalogue + booking API)
VENUE_SOURCE=mock
PLEC_SANDBOX_URL=https://api.plec.ai/hackathon/sandbox
PLEC_SANDBOX_KEY=

IMESSAGE_PROVIDER=simulator
# provider-specific (fill only the one in use)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
PHOTON_API_KEY=
LINQ_API_KEY=
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
WEBHOOK_SECRET=

# Kimi reasoning models: leave both unset. Set for other providers if you want.
LLM_TEMPERATURE=
LLM_NAMED_TOOL_CHOICE=

# Group calendar invites (optional). Empty = PLEC sends "add to calendar" links + an .ics instead.
# OAuth client (Web app) + refresh token from the OAuth Playground, scope calendar.events. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Public URL for the /ics and /cal links sent in the chat (your tunnel in a live demo).
PUBLIC_BASE_URL=

# Party playlist (optional). ONE Spotify Premium account owns the playlists; friends only text.
# Dashboard: create an app (Web API), add the redirect URI below EXACTLY, then open
# http://127.0.0.1:<PORT>/spotify/login once. The refresh token lands in data/spotify-token.json (gitignored).
# Empty = fallback: PLEC tracks the playlist itself and sends Spotify search links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8788/spotify/callback
